{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,

    // o .tsbuildinfo sai da raiz para nao ser versionado por acidente: com
    // 'tsc -b', estado de build alheio faz o compilador pular arquivo e o
    // erro so aparece na maquina de quem nao tem o arquivo
    "tsBuildInfoFile": "node_modules/.tmp/tsconfig.tsbuildinfo",

    // caminho absoluto '@/' para que mover pasta nao obrigue a reescrever
    // import relativo em dezenas de arquivos. Sem baseUrl: ele ficou obsoleto
    // no TypeScript 6 (o VS Code acusa erro) e sai no 7; o './' torna o
    // caminho relativo ao próprio tsconfig, que é o que o baseUrl fazia
    "paths": { "@/*": ["./src/*"] }
  },
  "include": ["src"]
}

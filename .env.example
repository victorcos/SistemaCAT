# Copiar para backend/.env e ajustar. Nunca versionar o .env real.

# Postgres, sempre: o do docker/docker-compose.yml. O SQLite ficou só para a
# bateria de testes do motor. Porta 55432: 5432 e 5433 costumam estar ocupadas
# por Postgres local.
CAT_BANCO_URL=postgresql+psycopg://cat:cat@localhost:55432/cat

# Token, pimenta e origens: lidos só pela API em C#.
# OBRIGATÓRIO trocar. Com o valor padrão, qualquer um forja um token.
# Gerar com: python -c "import secrets; print(secrets.token_urlsafe(48))"
CAT_JWT_SEGREDO=trocar-em-producao-isto-nao-e-segredo
CAT_JWT_MINUTOS=480

# Pimenta: segredo do servidor que entra no resumo da senha e NÃO fica no banco.
# Sem ela as senhas continuam protegidas por Argon2id com sal; com ela, vazar só
# o banco não basta para atacar as senhas.
# Gerar com: python -c "import secrets; print(secrets.token_urlsafe(32))"
# ATENÇÃO: trocar a pimenta invalida todas as senhas existentes.
CAT_SENHA_PIMENTA=

CAT_LOG_NIVEL=INFO
CAT_ORIGENS_PERMITIDAS=http://localhost:5173

# API em C# e motor Python (docs/MIGRACAO_CSHARP.md). Os padroes servem para
# a maquina de desenvolvimento; so mudar se a porta estiver ocupada.
# CAT_API_PORTA=8010
# CAT_MOTOR_URL=http://127.0.0.1:8020

# Processos que escrevem e pré-validam os arquivos digitais da CAT 42 ao mesmo
# tempo. Vazio ou 0: núcleos menos 4, entre 1 e 4. Se o motor ficar sem memória
# numa base grande, 1 volta a ler um arquivo por vez.
# CAT_PROCESSOS_DO_ARQUIVO_DIGITAL=0

# Cada rodada da fila num processo próprio: a memória volta ao sistema quando
# ela acaba. false roda dentro do motor, como antes da v0.53.
# CAT_RODADAS_EM_PROCESSO=true

# Segredo do canal interno: a API pede ao motor tudo o que é de disco (ler
# lote e remessa, rodar conferência e movimentos, gerar planilha, apagar pasta
# de trabalho). Vazio fecha o canal, e o sistema não trabalha.
# Gerar com: python -c "import secrets; print(secrets.token_urlsafe(32))"
CAT_MOTOR_SEGREDO=

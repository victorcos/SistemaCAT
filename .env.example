# Copiar para backend/.env e ajustar. Nunca versionar o .env real.

# Postgres em produção. SQLite serve para rodar local sem contêiner.
# porta 55432: 5432 e 5433 costumam estar ocupadas por Postgres local
CAT_BANCO_URL=postgresql+psycopg://cat:cat@localhost:55432/cat

# OBRIGATÓRIO trocar. Com o valor padrão, qualquer um forja um token.
# Gerar com: python -c "import secrets; print(secrets.token_urlsafe(48))"
CAT_JWT_SEGREDO=trocar-em-producao-isto-nao-e-segredo
CAT_JWT_MINUTOS=480

# Pimenta: segredo do servidor que entra no resumo da senha e NÃO fica no banco.
# Sem ela as senhas continuam protegidas por Argon2id com sal; com ela, vazar só
# o banco não basta para atacar as senhas.
# Gerar com: python -c "import secrets; print(secrets.token_urlsafe(32))"
# ATENÇÃO: trocar a pimenta invalida todas as senhas existentes.
CAT_SENHA_PIMENTA=

CAT_LOG_NIVEL=INFO
CAT_ORIGENS_PERMITIDAS=http://localhost:5173

# API em C# e motor Python (docs/MIGRACAO_CSHARP.md). Os padroes servem para
# a maquina de desenvolvimento; so mudar se a porta estiver ocupada.
# CAT_API_PORTA=8010
# CAT_MOTOR_URL=http://127.0.0.1:8020
